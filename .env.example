# Copy to .env and fill in. Values shown are for local development; the
# comments give what production (https://auth.jivo.in) needs.

# --- Django --------------------------------------------------------------
DEBUG=True                                   # production: False
DJANGO_SECRET_KEY=change-me                  # required when DEBUG is off
ALLOWED_HOSTS=localhost,127.0.0.1            # production: auth.jivo.in
PUBLIC_URL=http://localhost:8000             # production (required, https): https://auth.jivo.in
# LOG_LEVEL=INFO

# --- Docker (docker-compose.yml) -------------------------------------------
# APP_UID=1000                               # run as the owner of jwt_private.pem (`id -u`)
# APP_GID=1000                               # (`id -g`); default 10001, the image's user
# GUNICORN_BIND=127.0.0.1:8000               # host networking: only local Nginx reaches it
# WEB_CONCURRENCY=3                          # gunicorn workers
# RUN_MIGRATIONS=1                           # apply migrations on container start

# --- HTTPS (production, behind Nginx) --------------------------------------
# CSRF_TRUSTED_ORIGINS=https://auth.jivo.in
# TRUST_X_FORWARDED_PROTO=true               # Nginx must set X-Forwarded-Proto
# SECURE_SSL_REDIRECT=false                  # usually Nginx redirects instead
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
NUM_PROXIES=0                                # production behind Nginx: 1

# --- Database: PostgreSQL on this machine ---------------------------------
# The same values work for `runserver` and for the container, which shares
# the host's network.
POSTGRES_DB=jivo_auth
POSTGRES_USER=jivo_auth
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Tokens --------------------------------------------------------------
# RS256: generate a key with `uv run python -m config.jwt_keys > jwt_private.pem`.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_FILE=jwt_private.pem         # or JWT_PRIVATE_KEY with the PEM itself
# JWT_ISSUER=                                # defaults to PUBLIC_URL
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
# JWT_REFRESH_REUSE_GRACE_SECONDS=30         # a just-rotated refresh token still works this long
# HS256 instead (every verifying app then holds this secret):
# JWT_ALGORITHM=HS256
# JWT_SECRET_KEY=at-least-32-random-characters

# --- CORS: browser apps that call this API directly ----------------------
# CORS_ALLOWED_ORIGINS=https://oms.jivo.in,https://ecom.jivo.in
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.jivo\.in$

# --- Audit log -----------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=365               # `manage.py prune_audit_events` deletes older events

# --- Registration --------------------------------------------------------
REGISTRATION_ENABLED=True                    # default: on with DEBUG, off without
# REGISTRATION_EMAIL_DOMAINS=jivo.in         # comma-separated; empty allows any
# REQUIRE_VERIFIED_EMAIL=True                # login refused until the email is verified

# --- Email ---------------------------------------------------------------
EMAIL_BACKEND=console                        # production: smtp
DEFAULT_FROM_EMAIL=no-reply@localhost        # production: e.g. no-reply@jivo.in
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# Links in emails; {token} is replaced. Defaults: pages hosted by this service.
# PASSWORD_RESET_URL=https://auth.jivo.in/reset-password/?token={token}
# EMAIL_VERIFICATION_URL=https://auth.jivo.in/verify-email/?token={token}
