# Copy to deploy.env (gitignored) and fill in; ./deploy.sh reads it.
# Environment variables of the same names override these values.

# SSH destination of the server that runs the container.
DEPLOY_HOST=user@server.example.com

# Directory on the server holding the checkout, .env and jwt_private.pem.
DEPLOY_DIR=/home/user/jivo_auth

# Public URL, checked after each deploy.
DEPLOY_URL=https://auth.jivo.in
